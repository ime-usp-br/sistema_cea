# =============================================================================
# Contrato ÚNICO de variáveis — copie este bloco para o campo
# "Environment variables" da stack no Portainer.
#
# - NÃO crie .env.dev/.env.homolog/.env.prod no repositório.
# - NÃO coloque .env no servidor: os valores vivem no Portainer.
# - Os nomes são iguais em dev, homologação e produção; só os valores mudam.
# - Para uso local (CLI/testes), copie para .env (ignorado pelo Git).
# - DB_HOST é um DOMÍNIO do banco externo, nunca um serviço Compose
#   (db, mysql, postgres, mariadb, localhost).
# =============================================================================

# -----------------------------------------------------------------------------
# Geral / ambiente
# -----------------------------------------------------------------------------
# Obrigatória. Valores: dev | homolog | prod
APP_ENV=dev
# Nativo do Django: development | production.
# Mapeamento: APP_ENV=dev -> development; homolog/prod -> production.
DJANGO_ENV=development
# true SOMENTE em dev. Obrigatoriamente false em homolog e prod.
DEBUG=True
# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-use-a-real-secret-in-portainer
# Obrigatória. Hosts públicos separados por vírgula, sem esquema.
# dev: dev.<dominio> | homolog: homolog.<dominio> | prod: <dominio>
ALLOWED_HOSTS=dev.example.org
# URL pública canônica (usada em documentação e links absolutos).
APP_URL=https://dev.example.org
TZ=America/Sao_Paulo
# Porta interna do Gunicorn/runserver. Não é publicada; o NPM usa o alias.
WEB_PORT=8000
GUNICORN_WORKERS=3
LOG_LEVEL=INFO
# Django escreve em stdout/stderr; mantido para padronização/coleta.
LOG_CHANNEL=stdout
# Imagem/tag registrada no deploy (registry ou build local).
APP_IMAGE=sistema-cea-app:latest
# Prefixo usado nos nomes de backup.
PROJECT_NAME=sistema-cea

# -----------------------------------------------------------------------------
# Proxy reverso (Nginx Proxy Manager)
# -----------------------------------------------------------------------------
# Origens confiáveis para CSRF (esquema + host, sem barra final).
# dev: https://dev.<dominio> | homolog: https://homolog.<dominio> | prod: https://<dominio>
CSRF_TRUSTED_ORIGINS=https://dev.example.org
# Necessário atrás do NPM (envia X-Forwarded-Proto). Deixe vazio se não houver proxy.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# true apenas quando o proxy sobrescreve X-Forwarded-For de forma confiável.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=False

# -----------------------------------------------------------------------------
# Papel do container e etapas de boot
# -----------------------------------------------------------------------------
# web (default) | worker. O compose define worker automaticamente no serviço worker.
CONTAINER_ROLE=web
# Migrações apenas no serviço web. Em prod, rode uma réplica por vez.
RUN_MIGRATIONS=true
# Seeders SOMENTE em dev (nunca em prod; proibido com APP_ENV=prod).
# dev: true | homolog: false | prod: false
RUN_SEEDERS=true
# Aquece cache/estáticos no boot. dev: false | homolog: true | prod: true
WARM_CACHE=false

# -----------------------------------------------------------------------------
# Banco de dados EXTERNO (por domínio, fora da rede Docker da aplicação)
# -----------------------------------------------------------------------------
# postgres | mysql (mariadb é aceito como alias de mysql).
# MySQL/MariaDB usam PyMySQL, já incluído na imagem; não requer mysqlclient.
DB_CONNECTION=postgres
# Obrigatória. DOMÍNIO do banco do ambiente (não é serviço Compose).
# dev: db-dev.<dominio> | homolog: db-homolog.<dominio> | prod: db.<dominio>
DB_HOST=db-dev.example.org
# 5432 para postgres; 3306 (ou a porta publicada) para mysql/mariadb.
DB_PORT=5432
# Obrigatórias. Banco/usuário/senha específicos do projeto (solicite à infra).
DB_NAME=sistema_cea
DB_USER=sistema_cea
DB_PASSWORD=change-me-in-portainer
# Opcional. Prefira DB_* acima. Se preencher, use percent-encoding na senha.
DATABASE_URL=
# Espera do banco no entrypoint (retry/timeout).
DB_WAIT_TIMEOUT=90
DB_WAIT_INTERVAL=3
# Use true SOMENTE em stacks de teste com banco efêmero interno.
DB_ALLOW_LOCAL_HOST=false

# -----------------------------------------------------------------------------
# Backup / restore (scripts/backup-db.sh e scripts/restore-db.sh)
# -----------------------------------------------------------------------------
# Dentro do container o volume persistente é /app/backups.
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Redis / cache / Celery (serviços internos da stack)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Vazio deriva automaticamente de REDIS_URL (DB 1).
CACHE_URL=
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WEBHOOK=60
RATE_LIMIT_DOWNLOAD=30
RATE_LIMIT_POST=20

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
ENABLE_LOCAL_LOGIN=True
SENHAUNICA_KEY=
SENHAUNICA_SECRET=
SENHAUNICA_CALLBACK_ID=
# prod | dev
SENHAUNICA_ENV=prod
# Override opcional dos endpoints OAuth (faker local/E2E). Vazio = URL oficial.
SENHAUNICA_OAUTH_BASE_URL=
SENHAUNICA_LOGIN_REDIRECT_URL=/

# -----------------------------------------------------------------------------
# Replicado (Sybase/MSSQL)
# -----------------------------------------------------------------------------
REPLICADO_HOST=
REPLICADO_PORT=
REPLICADO_DATABASE=
REPLICADO_USERNAME=
REPLICADO_PASSWORD=
REPLICADO_SYBASE=

# -----------------------------------------------------------------------------
# Integração Pix (WSPIX)
# -----------------------------------------------------------------------------
PIX_BASE_URL=https://api-dev.portalservicos.usp.br/wspix/api
PIX_USERNAME=
PIX_PASSWORD=
# Deve coincidir com o token cadastrado no gateway.
PIX_WEBHOOK_TOKEN=change-me-in-portainer
PIX_EXPIRATION_SECONDS=3600
PIX_CODIGO_FONTE_RECURSO=423
PIX_CODIGO_UNIDADE_DESPESA=1
PIX_ESTRUTURA_HIERARQUICA=\DISTRIBUIDOR
PIX_RECONCILIATION_MAX_DAYS=30

# -----------------------------------------------------------------------------
# Integração Boleto (SOAP/WSDL)
# -----------------------------------------------------------------------------
BANK_SLIP_WSDL_URL=https://dev.uspdigital.usp.br/wsboleto/wsdl/boleto.wsdl
BANK_SLIP_USERNAME=
BANK_SLIP_PASSWORD=
BANK_SLIP_DUE_DAYS=3
BANK_SLIP_CODIGO_FONTE_RECURSO=423
BANK_SLIP_CODIGO_UNIDADE_DESPESA=1
BANK_SLIP_ESTRUTURA_HIERARQUICA=\DISTRIBUIDOR
BANK_SLIP_SACADO_INFO=Dúvidas: cea@ime.usp.br

# Gateways simulados: SOMENTE stacks de teste. Sempre false no deploy.
PAYMENT_GATEWAY_FAKE=False

# -----------------------------------------------------------------------------
# E-mail / notificações
# -----------------------------------------------------------------------------
# log|console imprime no stdout (dev); smtp envia de verdade (homolog/prod).
MAIL_DRIVER=log
MAIL_HOST=smtp.ime.usp.br
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@cea.ime.usp.br
MAIL_FROM_NAME=Inscrições CEA
# Destinatário do comando send_test_email quando --to não é informado.
MAIL_DEV_TEST=
# Avisos internos para a equipe CEA.
MAIL_CEA=cea@ime.usp.br
# Backend do Django (vazio = derivado de MAIL_DRIVER). Não usar filebased no deploy.
EMAIL_BACKEND=
EMAIL_FILE_PATH=
DEFAULT_FROM_EMAIL=
NOTIFICATION_CENTER_EMAIL=
