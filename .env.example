# Geral
DJANGO_ENV=development
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS/proxy reverso (produção)
# Origens confiáveis para CSRF, separadas por vírgula, com esquema e sem barra final.
# Ex.: https://cea.sistemas.ime.usp.br
CSRF_TRUSTED_ORIGINS=
# Somente se o proxy envia o header; formato "HEADER,valor".
# Ex.: HTTP_X_FORWARDED_PROTO,https
SECURE_PROXY_SSL_HEADER=

# Portas (Docker Compose)
WEB_PORT=8000

# Senha Única
SENHAUNICA_KEY=
SENHAUNICA_SECRET=
SENHAUNICA_CALLBACK_ID=
SENHAUNICA_ENV=prod

# Autenticação
# Habilita o login local (usuário/senha) além da Senha Única USP.
ENABLE_LOCAL_LOGIN=True

# Celery / Redis
REDIS_URL=redis://redis:6379/0
# Executa tarefas no processo (usado pela stack E2E; manter False em produção)
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# Replicado
REPLICADO_HOST=
REPLICADO_PORT=
REPLICADO_DATABASE=
REPLICADO_USERNAME=
REPLICADO_PASSWORD=
REPLICADO_SYBASE=

# ---- Integração Pix (WSPIX) ----
PIX_BASE_URL=https://api-dev.portalservicos.usp.br/wspix/api
PIX_USERNAME=
PIX_PASSWORD=
PIX_WEBHOOK_TOKEN=dev-webhook-token
PIX_EXPIRATION_SECONDS=3600
PIX_CODIGO_FONTE_RECURSO=423
PIX_CODIGO_UNIDADE_DESPESA=1
PIX_ESTRUTURA_HIERARQUICA=\DISTRIBUIDOR
PIX_RECONCILIATION_MAX_DAYS=30

# ---- Integração Boleto (WS-Boleto - SOAP/WSDL) ----
BANK_SLIP_WSDL_URL=https://dev.uspdigital.usp.br/wsboleto/wsdl/boleto.wsdl
BANK_SLIP_USERNAME=
BANK_SLIP_PASSWORD=
BANK_SLIP_DUE_DAYS=3
BANK_SLIP_CODIGO_FONTE_RECURSO=423
BANK_SLIP_CODIGO_UNIDADE_DESPESA=1
BANK_SLIP_ESTRUTURA_HIERARQUICA=\DISTRIBUIDOR
BANK_SLIP_SACADO_INFO=Dúvidas: cea@ime.usp.br

# Gateways simulados em memória (somente stack E2E/testes; nunca em produção)
PAYMENT_GATEWAY_FAKE=False

# ---- E-mail (notificações) ----
# log/console: imprime o e-mail no log do container (dev).
# smtp: envia de verdade usando MAIL_HOST/MAIL_PORT.
MAIL_DRIVER=log
# Backend do Django (opcional). A stack E2E usa filebased + EMAIL_FILE_PATH.
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=/tmp/cea-e2e-mail
MAIL_HOST=smtp.ime.usp.br
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@cea.ime.usp.br
MAIL_FROM_NAME=Inscrições CEA
# Destinatário usado pelo comando send_test_email quando --to não é informado.
MAIL_DEV_TEST=
# Destinatário dos avisos internos para a equipe CEA.
MAIL_CEA=cea@ime.usp.br
